// Real Oreslang compiler acceptance target for both-side 2D matmul VJP.
import module Assert from "std/assert";
import class TensorF64 from "../src/tensor.ores";
import module MatmulBothVjp from "../src/matmul_both_vjp.ores";

pub routine main(): void {
  val TensorF64 input = new TensorF64(
    arr[2, 2], arr[1.0, 2.0, 3.0, 4.0]
  );
  val TensorF64 weights = new TensorF64(
    arr[2, 2], arr[5.0, 6.0, 7.0, 8.0]
  );
  val TensorF64 upstream = new TensorF64(
    arr[2, 2], arr[1.0, 2.0, 3.0, 4.0]
  );
  val List<float> left_scratch = arr[0.0, 0.0, 0.0, 0.0];
  val List<float> right_scratch = arr[0.0, 0.0, 0.0, 0.0];
  val List<float> dx = arr[0.0, 0.0, 0.0, 0.0];
  val List<float> dw = arr[0.0, 0.0, 0.0, 0.0];
  Assert.true_throws(MatmulBothVjp.matmul_both_vjp_f64_checked_into(
    rt borrow input, rt borrow weights, rt borrow upstream, rt mut borrow left_scratch, rt mut borrow right_scratch, rt mut borrow dx, rt mut borrow dw
  ).is_ok());
  Assert.equal_throws(dx[0], 17.0);
  Assert.equal_throws(dx[1], 23.0);
  Assert.equal_throws(dx[2], 39.0);
  Assert.equal_throws(dx[3], 53.0);
  Assert.equal_throws(dw[0], 10.0);
  Assert.equal_throws(dw[1], 14.0);
  Assert.equal_throws(dw[2], 14.0);
  Assert.equal_throws(dw[3], 20.0);

  // Shapes fail closed: both destination buffers remain untouched.
  val TensorF64 bad_upstream = new TensorF64(
    arr[1, 4], arr[1.0, 2.0, 3.0, 4.0]
  );
  Assert.true_throws(MatmulBothVjp.matmul_both_vjp_f64_checked_into(
    rt borrow input, rt borrow weights, rt borrow bad_upstream, rt mut borrow left_scratch, rt mut borrow right_scratch, rt mut borrow dx, rt mut borrow dw
  ).is_err());
  Assert.equal_throws(dx[0], 17.0);
  Assert.equal_throws(dw[0], 10.0);

  // Nonfinite second-side accumulation leaves the published dX untouched.
  val TensorF64 huge_left = new TensorF64(
    arr[1, 1], arr[1.0e308]
  );
  val TensorF64 huge_weight = new TensorF64(
    arr[1, 1], arr[1.0]
  );
  val TensorF64 huge_upstream = new TensorF64(
    arr[1, 1], arr[1.0e308]
  );
  val List<float> huge_dx_scratch = arr[0.0];
  val List<float> huge_dw_scratch = arr[0.0];
  val List<float> huge_dx = arr[17.0];
  val List<float> huge_dw = arr[23.0];
  Assert.true_throws(MatmulBothVjp.matmul_both_vjp_f64_checked_into(
    rt borrow huge_left, rt borrow huge_weight, rt borrow huge_upstream,
    rt mut borrow huge_dx_scratch, rt mut borrow huge_dw_scratch, rt mut borrow huge_dx, rt mut borrow huge_dw
  ).is_err());
  Assert.equal_throws(huge_dx[0], 17.0);
  Assert.equal_throws(huge_dw[0], 23.0);

  // Huge logical zero-extent shapes must not cause billions of empty
  // row iterations, and all alias guards still apply to empty outputs.
  val TensorF64 empty_left = new TensorF64(arr[2000000000, 0], arr[]);
  val TensorF64 empty_right = new TensorF64(arr[0, 0], arr[]);
  val TensorF64 empty_upstream = new TensorF64(arr[2000000000, 0], arr[]);
  val List<float> empty_left_scratch = arr[];
  val List<float> empty_right_scratch = arr[];
  val List<float> empty_dx = arr[];
  val List<float> empty_dw = arr[];
  Assert.true_throws(MatmulBothVjp.matmul_both_vjp_f64_checked_into(
    rt borrow empty_left, rt borrow empty_right, rt borrow empty_upstream,
    rt mut borrow empty_left_scratch, rt mut borrow empty_right_scratch, rt mut borrow empty_dx, rt mut borrow empty_dw
  ).is_ok());

  // Typed alias-prohibition cases belong in negative compiler fixtures;
  // this positive runtime example must not fail to type-check intentionally.
  stdio.println("ORES_MATMUL_TWO_SIDED_VJP_PASS");
  return;
}
