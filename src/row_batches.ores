// Pure Oreslang CPU tensor row-batch primitives for data/ML pipelines.
// P0 storage remains List<float>, not verified contiguous Array<T> or zero-copy.
// No allocations in output kernels. All guest-visible output mutations follow
// shape/index/finite validation. Gradient scratch may change on failure;
// the output buffer MUST retain its previous contents on failure.
import class TensorF64 from './tensor';
import fnc validate_tensor, checked_numel from './tensor';

fnc count_ints(List<int> xs): int {
  let int n = 0;
  for const x of xs do
    n = n + 1;
  done
  return n;
}

fnc count_floats(List<float> xs): int {
  let int n = 0;
  for const x of xs do
    n = n + 1;
  done
  return n;
}

// Gather a specified row sequence from a [rows, columns] source.
// Indices may repeat: this is required for deterministic resampling.
// Result is [count(indices), columns] in input-index order.
pub fnc gather_rows_2d_f64_into(
  TensorF64 source,
  List<int> indices,
  List<float> mut output
): Result<bool, String> {
  if output is source.values; do
    return Err("gather output aliases source");
  fi
  if validate_tensor(source).is_err(); do
    return Err("invalid gather source tensor");
  fi
  if count_ints(source.shape) != 2; do
    return Err("gather source must have rank 2");
  fi

  val int rows = source.shape[0];
  val int columns = source.shape[1];
  val int selected = count_ints(indices);
  if checked_numel(arr[selected, columns], count_floats(output)).is_err(); do
    return Err("gather output shape mismatch");
  fi

  // Preflight all indices before publishing even one output element.
  for const index of indices do
    if index < 0 || index >= rows; do
      return Err("gather row index out of bounds");
    fi
  done

  for int i = 0; i < selected; i++ do
    val int source_row = indices[i];
    for int column = 0; column < columns; column++ do
      output[(i * columns) + column] =
        source.values[(source_row * columns) + column];
    done
  done
  return Ok(true);
}

// Contiguous mini-batch from a row-major source. No temporary index list.
// start==rows, count==0 is valid; count may not exceed rows-start.
pub fnc slice_rows_2d_f64_into(
  TensorF64 source,
  int start,
  int count,
  List<float> mut output
): Result<bool, String> {
  if output is source.values; do
    return Err("slice output aliases source");
  fi
  if validate_tensor(source).is_err(); do
    return Err("invalid slice source tensor");
  fi
  if count_ints(source.shape) != 2; do
    return Err("slice source must have rank 2");
  fi
  val int rows = source.shape[0];
  val int columns = source.shape[1];
  if start < 0 || count < 0 || start > rows; do
    return Err("invalid row slice bounds");
  fi
  // Subtract first to avoid overflow of start+count.
  if count > rows - start; do
    return Err("row slice extends beyond source");
  fi
  if checked_numel(arr[count, columns], count_floats(output)).is_err(); do
    return Err("row slice output shape mismatch");
  fi
  // Zero-extent slices have no values to copy. A shape like
  // [2000000000, 0] with count=2000000000 is valid but must not
  // spend billions of iterations in an empty inner column loop.
  // Keep this after alias, source, row bounds, and output validation.
  if count_floats(output) == 0; do
    return Ok(true);
  fi

  for int i = 0; i < count; i++ do
    for int column = 0; column < columns; column++ do
      output[(i * columns) + column] =
        source.values[((start + i) * columns) + column];
    done
  done
  return Ok(true);
}

// Reverse-mode VJP of gather_rows:
// dInput[row, c] = sum_{j: indices[j] == row} dOutput[j, c].
//
// Repeated indices MUST add, not overwrite. Accumulation is deterministic in
// the supplied index order. Staged scratch is caller-owned and may be changed
// before an error; the public output remains unchanged on every error.
// This function does not mutate source tensor or actor state.
pub fnc gather_rows_vjp_f64_checked_into(
  TensorF64 upstream,
  List<int> indices,
  List<int> source_shape,
  List<float> mut scratch,
  List<float> mut output
): Result<bool, String> {
  if scratch is output || scratch is upstream.values || output is upstream.values; do
    return Err("gather VJP buffers must be disjoint");
  fi
  if validate_tensor(upstream).is_err(); do
    return Err("invalid gather upstream gradient");
  fi
  if count_ints(upstream.shape) != 2 || count_ints(source_shape) != 2; do
    return Err("gather VJP requires rank-2 shapes");
  fi

  val int rows = source_shape[0];
  val int columns = source_shape[1];
  val int selected = count_ints(indices);
  if rows < 0 || columns < 0; do
    return Err("negative original tensor extent");
  fi
  if upstream.shape[0] != selected || upstream.shape[1] != columns; do
    return Err("gather upstream shape mismatch");
  fi
  val int n = count_floats(output);
  if count_floats(scratch) != n; do
    return Err("gather VJP scratch length mismatch");
  fi
  if checked_numel(source_shape, n).is_err(); do
    return Err("gather original shape mismatch");
  fi

  for const index of indices do
    if index < 0 || index >= rows; do
      return Err("gather VJP row index out of bounds");
    fi
  done

  for int k = 0; k < n; k++ do
    scratch[k] = 0.0;
  done
  for int i = 0; i < selected; i++ do
    val int row = indices[i];
    for int column = 0; column < columns; column++ do
      val int destination = (row * columns) + column;
      val float next = scratch[destination] +
        upstream.values[(i * columns) + column];
      if (next - next) != 0.0; do
        return Err("nonfinite gather VJP accumulation");
      fi
      scratch[destination] = next;
    done
  done

  for int k = 0; k < n; k++ do
    output[k] = scratch[k];
  done
  return Ok(true);
}
